# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Only `--solver agent` needs this. The gold, noop, replay, and cmd solvers
# make zero API calls, so the whole development loop works without a key.
#
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Overrides the default model for --solver agent.
# Current options: claude-opus-5, claude-sonnet-5, claude-sonnet-4-6, claude-haiku-4-5
# HARNESS_MODEL=claude-sonnet-4-6
