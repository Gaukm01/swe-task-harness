# Secrets and local config
.env
.venv/

# Working notes, not deliverables -- except docs/images/, which the committed
# DESIGN.md embeds.
CLAUDE.md
docs/*
!docs/images/

# Scratch from development runs. The three DELIVERABLE runs, their database,
# and the rendered site ARE committed — a reviewer browses the results and
# replays the cassettes from a clean clone with no API key.
runs-archive/
harness-archive.db
artifacts/

# No test may write run artifacts into a bundle: it pollutes the deliverable
# and feeds hash_build_context, silently changing the environment cache key.
examples/*/x/
examples/*/*/x/

__pycache__/
.DS_Store

# SQLite WAL sidecars (transient; the checkpointed harness.db is committed)
harness.db-shm
harness.db-wal
