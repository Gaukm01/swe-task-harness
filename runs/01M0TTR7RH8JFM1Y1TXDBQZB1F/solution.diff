+def _new_sanitize_container(value, deferred):
+    """
+    Helper for :func:`sanitize_keys`.
+
+    If *value* is a container (Mapping, MutableSequence, generic Sequence, or
+    Set) a new, empty container of the appropriate type is created, the
+    *(old, new)* pair is appended to *deferred* so that the main loop can fill
+    it in later, and the new container is returned.  All other values are
+    returned unchanged.
+
+    :arg value: The value to inspect.
+    :arg deferred: A deque to which container pairs are appended.
+    :returns: A new empty container, or *value* itself for scalars.
+    """
+    if isinstance(value, Mapping):
+        new_value = type(value)() if isinstance(value, MutableMapping) else {}
+        deferred.append((value, new_value))
+        return new_value
+    if isinstance(value, MutableSequence):
+        new_value = type(value)()
+        deferred.append((value, new_value))
+        return new_value
+    if isinstance(value, Sequence) and not isinstance(value, (text_type, binary_type)):
+        # Non-mutable sequences (e.g. tuples) are stored as lists temporarily
+        new_value = []
+        deferred.append((value, new_value))
+        return new_value
+    if isinstance(value, MutableSet):
+        new_value = type(value)()
+        deferred.append((value, new_value))
+        return new_value
+    if isinstance(value, Set):
+        new_value = set()
+        deferred.append((value, new_value))
+        return new_value
+    return value
+
+
+def sanitize_keys(obj, no_log_strings, ignore_keys=frozenset()):
+    """Return a copy of *obj* in which every mapping key that contains any
+    string from *no_log_strings* is redacted.
+
+    :arg obj: The object whose mapping keys should be sanitised.  If *obj* is
+        not a :class:`~collections.abc.Mapping` it is returned unchanged.
+    :arg no_log_strings: An iterable of strings (text or bytes) whose
+        occurrences in mapping key names must be masked.  Each element is
+        converted to a native string via :func:`to_native` before use.
+    :arg ignore_keys: A :class:`frozenset` of exact key names that must
+        **not** be sanitised even if they contain a sensitive substring.
+        Defaults to an empty set.
+    :returns: A copy of *obj* with sensitive key names masked (substrings
+        replaced by '********') or replaced by the sentinel
+        'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER' when the full key name
+        matches a sensitive string.  Non-mapping objects are returned
+        unchanged.
+
+    Keys that start with '_ansible' are always preserved regardless of
+    *no_log_strings*.
+
+    Uses an iterative (deferred) approach to avoid hitting Python's recursion
+    limit on deeply nested structures.
+    """
+    no_log_strings = [to_native(s, errors='surrogate_or_strict') for s in no_log_strings]
+
+    if not no_log_strings or not isinstance(obj, Mapping):
+        return obj
+
+    deferred = deque()
+    result = _new_sanitize_container(obj, deferred)
+
+    while deferred:
+        old_data, new_data = deferred.popleft()
+        if isinstance(new_data, Mapping):
+            for key, value in old_data.items():
+                new_value = _new_sanitize_container(value, deferred)
+
+                key_native = to_native(key, errors='surrogate_or_strict')
+                if key_native in ignore_keys or key_native.startswith('_ansible'):
+                    new_key = key_native
+                elif key_native in no_log_strings:
+                    new_key = 'VALUE_SPECIFIED_IN_NO_LOG_PARAMETER'
+                else:
+                    new_key = key_native
+                    for omit_me in no_log_strings:
+                        new_key = new_key.replace(omit_me, '*' * 8)
+
+                new_data[new_key] = new_value
+        elif isinstance(new_data, MutableSequence):
+            for elem in old_data:
+                new_data.append(_new_sanitize_container(elem, deferred))
+        elif isinstance(new_data, MutableSet):
+            for elem in old_data:
+                new_data.add(_new_sanitize_container(elem, deferred))
+
+    return result
+
